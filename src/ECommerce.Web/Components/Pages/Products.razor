@page "/products"
@using ECommerce.Web.Services
@inject CatalogApiClient Catalog
@inject OrderingApiClient Ordering
@rendermode InteractiveServer

<PageTitle>Catalog</PageTitle>

<h1>Catalog</h1>

@if (_products is null)
{
    <p role="status"><em>Loading products…</em></p>
}
else
{
    <div class="table-responsive table-card">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Product</th>
                    <th scope="col">Description</th>
                    <th scope="col" class="text-end">Price</th>
                    <th scope="col" class="text-end">Stock</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _products)
                {
                    <tr>
                        <td class="product-name">@p.Name</td>
                        <td class="product-description">@p.Description</td>
                        <td class="text-end numeric">@p.Price.ToString("C")</td>
                        <td class="text-end numeric">@p.AvailableStock</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AddToCart(p)">Add</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <section class="cart-panel">
        <h2>Cart</h2>
        @if (_cart.Count == 0)
        {
            <p class="cart-empty"><em>Your cart is empty.</em></p>
        }
        else
        {
            <ul class="cart-list">
                @foreach (var line in _cart)
                {
                    <li>@line.Value × @line.Key.Name (@line.Key.Price.ToString("C"))</li>
                }
            </ul>

            <div class="mb-3">
                <label class="form-label" for="customer-name">Customer name</label>
                <input id="customer-name" class="form-control customer-input" @bind="_customer" />
            </div>
            <button class="btn btn-primary" @onclick="PlaceOrder" disabled="@_placing">Place order</button>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3 mb-0" role="@(_isError ? "alert" : "status")">@_message</div>
        }
    </section>
}

@code {
    private IReadOnlyList<ProductDto>? _products;
    private readonly Dictionary<ProductDto, int> _cart = new();
    private string _customer = "";
    private bool _placing;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _products = await Catalog.GetProductsAsync();
    }

    private void AddToCart(ProductDto product)
    {
        _cart[product] = _cart.TryGetValue(product, out var qty) ? qty + 1 : 1;
        _message = null;
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrWhiteSpace(_customer))
        {
            _message = "Please enter a customer name.";
            _isError = true;
            return;
        }

        _placing = true;
        var order = new CreateOrderDto(
            _customer,
            _cart.Select(c => new OrderLineDto(c.Key.Id, c.Value)).ToList());

        var (success, error) = await Ordering.CreateOrderAsync(order);
        _placing = false;

        if (success)
        {
            _message = "Order placed successfully!";
            _isError = false;
            _cart.Clear();
            _customer = "";
        }
        else
        {
            _message = $"Failed to place order: {error}";
            _isError = true;
        }
    }
}
